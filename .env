# DEMO BUILD -- no secrets live here and none are needed.
# The database is PGlite, started by `npm run dev` (scripts/demo-db.mts),
# which also sets DATABASE_URL for the app; these values match it.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"

NEXT_PUBLIC_APP_URL=http://localhost:3000

# No email, Gmail drafts or Drive uploads, ever.
SAFE_MODE=1

# Left blank on purpose: Supabase, Resend, Gemini, Google, Sentry, reCAPTCHA.
# AI-assisted entry and the Analytics tab show their "not configured" states.
